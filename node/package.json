{
  "scripts": {
    "dev": "npm-run-all --parallel css js",
    "css": "npx postcss \"/app/**/style.css\" --base /app/ --dir /app/ --ext .min.css --watch --config /node/postcss/postcss.config.js --ignore \"**/*.bak/**\" > postcss.log 2>&1",
    "js" : "npx esbuild /app/**/main.js --bundle --minify --format=esm --outbase=/app/ --outdir=/app/ --entry-names=[dir]/main.min --external:*.bak --external:bak/* --log-level=error --watch > efbuild.log 2>&1"
  },
  "name": "node",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.20.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "cssnano": "^7.0.0",
    "autoprefixer": "^10.4.0",
    "npm-run-all": "^4.1.5"
    }
}
